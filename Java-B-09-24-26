//Recursive Function/: calls itself with smaller problem
static int factorial(int n){
    if(n <= 1){
        return 1;
    }
    return n * factorial(n-1);
}

static int for multiply (int a, int b){
    return a * b;
}

static double multiply (double a, double b){
